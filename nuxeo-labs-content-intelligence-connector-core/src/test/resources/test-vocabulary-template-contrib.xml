<?xml version="1.0"?>
<!--
  Test-only contribution.

  template-vocabulary is normally provided by org.nuxeo.ecm.directories, which lives in
  nuxeo-platform-default-config — a bundle that is NOT on this module's test classpath. Without it, the
  cicImageClassification / cicTextClassification directories, which declare extends="template-vocabulary",
  cannot resolve and are silently not registered.

  Redeclaring it here mirrors exactly what the platform does (schema + idField on top of template-directory,
  the latter being supplied by DirectoryFeature) so the real contribution is exercised as deployed.
-->
<component name="org.nuxeo.labs.hyland.content.intelligence.test.vocabularytemplate">

  <extension target="org.nuxeo.ecm.directory.GenericDirectory" point="directories">

    <directory name="template-vocabulary" template="true" extends="template-directory">
      <schema>vocabulary</schema>
      <idField>id</idField>
    </directory>

  </extension>

</component>
