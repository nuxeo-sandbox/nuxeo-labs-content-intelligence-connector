<?xml version="1.0"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.nuxeo.labs.content.intelligence</groupId>
        <artifactId>nuxeo-labs-content-intelligence-connector-parent</artifactId>
        <version>2025.22.0-SNAPSHOT</version>
    </parent>
    <artifactId>nuxeo-labs-content-intelligence-connector-core</artifactId>
    <name>Nuxeo Labs Content Intelligence Connector core</name>
    <description>Core bundle: services, automation operations, document model and Web UI resources.</description>

    <properties>
        
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.nuxeo.runtime</groupId>
            <artifactId>nuxeo-runtime</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.nuxeo.ecm.core</groupId>
            <artifactId>nuxeo-core-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.nuxeo.ecm.automation</groupId>
            <artifactId>nuxeo-automation-core</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.nuxeo.ecm.platform</groupId>
            <artifactId>nuxeo-platform-imaging-core</artifactId>
            <scope>provided</scope>
        </dependency>

        <!--
            Used by ~20 classes of this module. It reaches the classpath only through a four-level transitive
            chain (nuxeo-runtime -> nuxeo-runtime-stream -> nuxeo-launcher-commons -> nuxeo-connect-client),
            so any Nuxeo-side change to that chain would break compilation with no warning. Version is managed
            by the Nuxeo parent.
        -->
        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.nuxeo.ecm.platform</groupId>
            <artifactId>nuxeo-platform-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.nuxeo.ecm.automation</groupId>
            <artifactId>nuxeo-automation-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

</project>